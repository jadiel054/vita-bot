# ─── VitaBot — Variáveis de Ambiente ──────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com dados reais no repositório.

# ─── Twilio / WhatsApp ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_seu_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=+14155238886

# Número WhatsApp da clínica para receber notificações
CLINIC_WHATSAPP=+5511999999999

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Autenticação OAuth (Manus) ───────────────────────────────────────────────
# Necessário para login via Manus OAuth
VITE_APP_ID=seu_app_id_aqui
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OAUTH_SERVER_URL=https://oauth.manus.im
JWT_SECRET=seu_jwt_secret_super_seguro_aqui

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DATABASE_URL=mysql://usuario:senha@host:3306/vitabot

# ─── Admin Permanente ─────────────────────────────────────────────────────────
# OpenID do proprietário do sistema (obtido após primeiro login OAuth)
OWNER_OPEN_ID=seu_open_id_aqui
OWNER_NAME=Seu Nome Aqui

# Credenciais do admin master (para login direto no painel)
EXPO_PUBLIC_ADMIN_EMAIL=admin@suaclinica.com.br
EXPO_PUBLIC_ADMIN_PASSWORD_HASH=sua_senha_segura_aqui

# ─── Pagamento / PIX ──────────────────────────────────────────────────────────
# Chave PIX para recebimento (CPF, CNPJ, e-mail, telefone ou chave aleatória)
EXPO_PUBLIC_PIX_KEY=+5511999999999
EXPO_PUBLIC_PIX_RECEIVER_NAME=Nome Recebedor PIX
EXPO_PUBLIC_PIX_CITY=Sua Cidade

# Links de checkout (Stripe, Hotmart, Kiwify, PagSeguro, etc.)
EXPO_PUBLIC_CHECKOUT_PRO=https://checkout.seugateway.com/pro
EXPO_PUBLIC_CHECKOUT_PREMIUM=https://checkout.seugateway.com/premium

# WhatsApp para vendas/suporte
EXPO_PUBLIC_WHATSAPP_SALES=+5511999999999

# ─── IA / Manus Forge ─────────────────────────────────────────────────────────
BUILT_IN_FORGE_API_KEY=sua_manus_api_key_aqui
BUILT_IN_FORGE_API_URL=https://forge.manus.im

# Provedores externos de IA (opcionais)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ─── Frontend / Deploy ────────────────────────────────────────────────────────
EXPO_PORT=8081
EXPO_PUBLIC_API_BASE_URL=https://seu-app.vercel.app
